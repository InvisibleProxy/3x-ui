# ========================================================
# Stage 1: Download Xray binary and geo files
# ========================================================
FROM alpine:3.19 AS downloader

ARG TARGETPLATFORM
ARG XRAY_VERSION=25.10.15

# Install tools, download Xray and geo files in single layer
RUN apk add --no-cache wget unzip bash && \
    mkdir -p /usr/share/xray

COPY --chmod=755 xray.sh /tmp/xray.sh
RUN /tmp/xray.sh "${TARGETPLATFORM}" "${XRAY_VERSION}" && \
    wget --progress=dot:mega -O /usr/share/xray/geoip.dat https://github.com/runetfreedom/russia-v2ray-rules-dat/releases/latest/download/geoip.dat && \
    wget --progress=dot:mega -O /usr/share/xray/geosite.dat https://github.com/runetfreedom/russia-v2ray-rules-dat/releases/latest/download/geosite.dat

# ========================================================
# Stage 2: Runtime image
# ========================================================
FROM alpine:3.19

WORKDIR /etc/xray

# Install runtime dependencies and create directories
RUN apk add --no-cache ca-certificates tzdata bash && \
    mkdir -p /var/log/xray /usr/local/share/xray

# Copy Xray binary and geo files from downloader
COPY --from=downloader /usr/bin/xray /usr/bin/xray
COPY --from=downloader /usr/share/xray/*.dat /usr/local/share/xray/

ARG XRAY_VERSION=25.10.15
ENV XRAY_CORE_VERSION=${XRAY_VERSION}

CMD ["/usr/bin/xray", "run", "-c", "/etc/xray/config.json"]
